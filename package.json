{
	"name": "portafolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"process-media": "node scripts/process-home-media.js",
		"build": "node scripts/standardize-images.js && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"rename": "node scripts/rename.js",
		"rename:apply": "node scripts/rename.js --apply",
		"upload": "node --env-file=.env.local scripts/upload.js",
		"seed": "node --env-file=.env.local scripts/seed.js",
		"seed:dry": "node --env-file=.env.local scripts/seed.js --dry-run",
		"scrape": "node --env-file=.env.local scripts/scrape-music.js",
		"scrape:dry": "node scripts/scrape-music.js --dry-run",
		"enrich": "node --env-file=.env.local scripts/enrich-music.js",
		"enrich:dry": "node --env-file=.env.local scripts/enrich-music.js --dry-run"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^25.0.9",
		"autoprefixer": "^10.4.20",
		"marked": "^18.0.5",
		"sharp": "^0.34.5",
		"shiki": "^4.2.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^3.4.9",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"wrangler": "^4.86.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.106.2",
		"resend": "^6.12.3",
		"stripe": "^22.1.1"
	}
}
